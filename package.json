{
  "name": "open-kyc",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev:all": "docker compose -f compose.yaml -f compose.dev.yaml up -d postgres redis falkordb ocr-indra && npm run db:migrate && npm run dev",
    "build:services": "docker compose -f compose.yaml -f compose.dev.yaml build ocr-indra",
    "start:all": "npm run dev:all",
    "dev": "concurrently -k npm:dev:web npm:dev:api",
    "dev:web": "vite --host 0.0.0.0 --port 3000",
    "dev:api": "tsx watch server/index.ts",
    "build": "vite build && tsc --noEmit",
    "bundle": "node scripts/bundle-server.mjs",
    "start": "tsx server/index.ts",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "test:integration": "tsx tests/integration.ts",
    "test:e2e": "playwright test",
    "test:e2e-screening": "tsx tests/nk-screening-e2e.ts",
    "demo:documents": "tsx scripts/gen-demo-documents.ts",
    "demo:seed": "tsx scripts/seed-demo-data.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src server packages scripts tests",
    "selfhost:init": "node scripts/selfhost-init.mjs",
    "setup": "node scripts/selfhost-up.mjs",
    "docker:clean": "docker image prune -f && docker builder prune -f",
    "lint": "tsc --noEmit",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.71",
    "@aws-sdk/client-s3": "^3.925.0",
    "@google-cloud/storage": "^8.1.0",
    "ai": "^7.0.143",
    "better-auth": "^1.7.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "file-type": "^21.0.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "nodemailer": "^10.0.10",
    "pg": "^8.16.3",
    "remark-gfm": "^4.0.1",
    "resend": "^6.34.1",
    "tesseract.js": "^5.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@heroicons/react": "^2.2.0",
    "@playwright/test": "^1.56.1",
    "@react-email/components": "^1.0.0",
    "@tailwindcss/vite": "^4.1.13",
    "@tanstack/eslint-config": "^0.3.2",
    "@tanstack/react-form": "^1.23.8",
    "@tanstack/react-query": "^5.90.7",
    "@tanstack/react-router": "^1.132.2",
    "@tanstack/react-router-with-query": "^1.130.17",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-plugin": "^1.132.2",
    "@types/culori": "^4.0.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.3",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "~9.2.1",
    "culori": "^4.0.2",
    "date-fns": "^4.1.0",
    "drizzle-kit": "^0.31.5",
    "esbuild": "^0.28.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.552.0",
    "motion": "^12.23.24",
    "openai": "^7.36.0",
    "prettier": "^3.6.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-aria-components": "^1.13.0",
    "react-dom": "^19.1.1",
    "react-is": "^19.3.1",
    "react-lottie-player": "^2.1.0",
    "react-markdown": "^10.1.0",
    "react-qr-code": "^2.0.18",
    "react-scan": "^0.5.7",
    "recharts": "^3.4.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.1.1",
    "tailwindcss": "^4.1.13",
    "tailwindcss-react-aria-components": "^2.0.1",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "uuid": "^13.0.0",
    "vite": "^7.1.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "zod-to-json-schema": "^3.24.6"
  },
  "workspaces": [
    "packages/*"
  ]
}
