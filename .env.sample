# Generate random secrets with npm run selfhost:init. Never commit .env.
APP_URL=http://localhost:3000
APP_PORT=3000
BIND_ADDRESS=127.0.0.1
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
DATABASE_URL=postgresql://openkyc:password@localhost:5432/openkyc
REDIS_URL=redis://:password@localhost:6379
PORT=3001
STORAGE_PROVIDER=local
STORAGE_PATH=./data/uploads
# AWS S3: standard AWS credential chain, IAM role or environment credentials.
AWS_REGION=us-east-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Cloudflare R2: an API token with Object Read & Write permissions.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# GCS: Application Default Credentials, workload identity or a mounted key file.
GCS_BUCKET=
GOOGLE_CLOUD_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcs.json
SMTP_URL=
SMTP_FROM=OpenKYC <noreply@example.com>
WEBHOOK_ALLOWED_HOSTS=
FIRECRAWL_API_KEY=
# FalkorDB powers knowledge-graph ingestion, the graph-algorithm AML analysis,
# and the agent's graph retrieval. Optional: without it the app keeps running
# and sessions settle with amlStatus=unavailable.
FALKORDB_BIND=127.0.0.1
FALKORDB_PORT=6380
FALKORDB_GRAPH=openkyc_aml
# NVIDIA NIM API key for the agentic compliance chat (/agent) and the
# nvidia/nemotron-3-embed-1b graph embeddings. Without it the chat reports
# generation is not configured and the graph falls back to keyword retrieval.
NVIDIA_API_KEY=
# Embedding model for FalkorDB graph vectors + semantic retrieval (optional,
# defaults to nvidia/nemotron-3-embed-1b).
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
# Set only behind exactly one trusted reverse proxy.
TRUST_PROXY=0
